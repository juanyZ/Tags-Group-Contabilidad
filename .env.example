# ============================================================
#  Copiar a .env y completar. El .env NUNCA se commitea.
#  Generar secretos con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ============================================================

NODE_ENV=development

# --- MySQL -------------------------------------------------
MYSQL_ROOT_PASSWORD=cambiar_root_password
MYSQL_DATABASE=estudio_juridico
MYSQL_PORT=3306

# Usuario del runtime: solo DML (SELECT/INSERT/UPDATE/DELETE). Sin DDL.
MYSQL_APP_USER=ej_app
MYSQL_APP_PASSWORD=cambiar_app_password

# Usuario exclusivo de migraciones: agrega DDL. No lo usa el servidor en ejecucion.
MYSQL_MIGRATE_USER=ej_migrate
MYSQL_MIGRATE_PASSWORD=cambiar_migrate_password

# --- Backend -----------------------------------------------
BACKEND_PORT=4000
# Secreto de firma del access token. Minimo 32 caracteres.
JWT_ACCESS_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads

# --- Frontend ----------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000/api/v1

# --- Email (opcional). Dejar vacio desactiva el envio. -----
NOTIFY_CRON_ENABLED=false
NOTIFY_CRON_HOUR=8
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
